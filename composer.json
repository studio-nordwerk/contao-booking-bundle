{
  "name": "nordwerk/contao-booking-bundle",
  "description": "Appointment booking for Contao: free times, instant booking, confirmation with calendar file, webhooks",
  "license": "MIT",
  "type": "contao-bundle",
  "keywords": [
    "contao",
    "booking",
    "appointment",
    "terminbuchung"
  ],
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.7",
    "sabre/vobject": "^4.5",
    "symfony/http-client": "^7.4",
    "symfony/mailer": "^7.4"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0"
  },
  "conflict": {
    "contao/core-bundle": "<5.7.12",
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "autoload": {
    "psr-4": {
      "Nordwerk\\BookingBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Nordwerk\\BookingBundle\\ContaoManager\\Plugin"
  }
}
